# Yalnızca adlar. Değerler GitHub Secrets / Vercel Environment Variables içinde durur (docs/SIRLAR.md).

# --- Vercel (panel) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=                # yalnızca https://<proje>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=                 # her zaman yönetici olan e-posta (e-postası doğrulanmış olmalı)
GH_TOKEN=                    # fine-grained, süreli: bu repo için Actions -> Read and write
GH_REPO=awanexli-blip/API

# --- GitHub Secrets (worker) ---
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
# XML_URL (eski BayilikXML; artık kullanılmıyor, tedarikçi adresleri veritabanında)
# TRENDYOL_SELLER_ID, TRENDYOL_API_KEY, TRENDYOL_API_SECRET,
# TRENDYOL_SHIPMENT_ADDRESS_ID, TRENDYOL_RETURN_ADDRESS_ID
# HB_MERCHANT_ID, HB_USERNAME, HB_PASSWORD (HB_USER_AGENT Variable ya da Secret)
# AMAZON_LWA_CLIENT_ID, AMAZON_LWA_CLIENT_SECRET, AMAZON_REFRESH_TOKEN, AMAZON_SELLER_ID

# --- GitHub Variables (opsiyonel) ---
# TRENDYOL_STOREFRONT, TRENDYOL_BRAND_NAME, HB_ENV (boş = SIT, prod), HB_USER_AGENT,
# SYNC_MARKETPLACES (zamanlı senkrondaki pazaryerleri, JSON dizi), SEND_JOBS_PER_RUN (varsayılan 25)
