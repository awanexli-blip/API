# /etc/trentakip/env  (sahibi trentakip, izin 600; depoya GİRMEZ). Değerler GitHub Secrets'takilerle aynı.
# Satır biçimi: AD=değer (tırnak yok, boşluk yok)

# Sunucu kimliği: IP izinli tedarikçi API'leri (feeds[].api.runner = "vps") yalnızca bununla okunur
RUNNER=vps

# Veritabanı (Supabase; ileride sunucudaki Postgres)
SUPABASE_URL=https://utuwjqfcaiqlqdzzagmm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Sunucuya taşıma denemesi (ops/vps/db/mirror.sh): Supabase > Connect > Session pooler adresi (parolalı, GitHub'daki SUPABASE_DB_URL2 ile aynı)
SUPABASE_DB_URL=

# GitHub iş akışlarını tam vaktinde başlatmak için (fine-grained token: yalnızca bu depo, Actions: Read and write)
GH_TOKEN=
GH_REPO=awanexli-blip/API
SYNC_MARKETPLACES=["trendyol","hepsiburada"]

# Telegram uyarıları (içe aktarma durursa)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tedarikçi REST API anahtarları (panelde auth.secret_env ile verilen adlar). GitHub'da aynı satırlar SUPPLIER_SECRETS secret'ında.
# ORNEK_TEDARIKCI_TOKEN=
