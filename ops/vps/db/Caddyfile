# Supabase adres düzeni: /rest/v1 (PostgREST), /auth/v1 (GoTrue), /storage/v1 (görsel). Sertifika Let's Encrypt, otomatik.
{$DOMAIN} {
	encode gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
	}

	# Veri: yalnızca sunucu tarafı (worker, panel API'si) kullanır, tarayıcıya açılmaz (CORS yok)
	handle_path /rest/v1/* {
		request_body {
			max_size 50MB
		}
		reverse_proxy rest:3000
	}

	# Giriş: tarayıcı panelden çağırır. CORS yalnızca panel adresine ve onun Vercel önizlemelerine (trentakip-*.vercel.app)
	@panel header_regexp origin Origin ^(https://trentakip(-[a-z0-9-]+)?\.vercel\.app|{$PANEL_URL})$
	@authPreflight {
		method OPTIONS
		path /auth/v1/*
	}
	handle @authPreflight {
		header @panel Access-Control-Allow-Origin "{re.origin.0}"
		header @panel Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
		header @panel Access-Control-Allow-Headers "authorization, apikey, content-type, x-client-info, x-supabase-api-version"
		header @panel Access-Control-Max-Age "600"
		header Vary Origin
		respond 204
	}
	handle_path /auth/v1/* {
		header @panel Access-Control-Allow-Origin "{re.origin.0}"
		header @panel Access-Control-Allow-Credentials "true"
		header Vary Origin
		reverse_proxy auth:9999 {
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Credentials
		}
	}

	# Görseller: herkese açık okuma diskten, yükleme service_role ile depo servisine
	handle_path /storage/v1/object/public/* {
		root * /srv/storage
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle_path /storage/v1/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy storage:5000
	}

	handle {
		respond 404
	}
}
