[Unit]
Description=Trentakip: kodu GitHub main'den güncelle (yalnızca ileri sarma; değişince bağımlılıklar ve panel)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=trentakip
WorkingDirectory=/opt/trentakip
ExecStart=/bin/bash /opt/trentakip/ops/vps/update.sh
# Panel yeniden derlendiyse yeniden başlat (root)
ExecStartPost=+/bin/sh -c 'if [ -f /opt/trentakip/.panel-restart ]; then rm -f /opt/trentakip/.panel-restart; systemctl restart trentakip-panel.service; fi'
TimeoutStartSec=20min
