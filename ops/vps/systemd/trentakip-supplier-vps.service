[Unit]
Description=Trentakip: IP izinli tedarikçi API'lerini içe aktar (yalnızca runner=vps olanlar)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=trentakip
EnvironmentFile=/etc/trentakip/env
Environment=NODE_OPTIONS=--max-old-space-size=1536
Environment=ACTOR=sunucu
WorkingDirectory=/opt/trentakip
# Ağır iş (K 18.11): aynı anda tek ağır iş; diğerleri kilidi bekler (en çok 3 saat). Senkronlar (stok/fiyat) bu kilide girmez.
ExecStart=/usr/bin/flock -w 10800 /run/lock/trentakip-heavy.lock /usr/bin/node --experimental-strip-types worker/import-xml.ts vps
TimeoutStartSec=40min
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log/trentakip
PrivateTmp=true
