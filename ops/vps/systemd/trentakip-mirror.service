[Unit]
Description=Trentakip: Supabase -> sunucu veritabanı kopyası (deneme süresi; Supabase'e yazmaz)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/trentakip/ops/vps/db/mirror.sh
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
