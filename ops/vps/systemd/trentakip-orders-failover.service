[Unit]
Description=Trentakip GEÇİCİ: Supabase kısıtlıyken siparişler sunucu veritabanına (SYNC_PART=orders; 12.11 egress kotası)
# Supabase dönünce kendiliğinden durur (ExecCondition: Supabase REST cevap veriyorsa çalışmaz).
# Kalıcı değil: tam taşıma (docs/TODO.md 03.11 madde 6) yapılınca kaldırılır. Timer: trentakip-orders-failover.timer
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=trentakip
WorkingDirectory=/opt/trentakip
EnvironmentFile=/etc/trentakip/env
EnvironmentFile=/etc/trentakip/keys.env
Environment=TRIGGER=schedule ACTOR=siparis-failover SYNC_PART=orders
# Supabase REST sağlıklıysa (kısıt kalktıysa) çalışma atlanır: GitHub senkronu görevi geri alır, çift bildirim olmaz
ExecCondition=/bin/sh -c '! curl -sf -m 10 -H "apikey: $SUPABASE_SERVICE_ROLE_KEY" -H "Authorization: Bearer $SUPABASE_SERVICE_ROLE_KEY" "$SUPABASE_URL/rest/v1/settings?select=id&limit=1" > /dev/null'
ExecStart=/bin/sh -c 'SUPABASE_URL=$VPS_SUPABASE_URL SUPABASE_SERVICE_ROLE_KEY=$VPS_SERVICE_ROLE_KEY node --experimental-strip-types worker/sync.ts auto trendyol; SUPABASE_URL=$VPS_SUPABASE_URL SUPABASE_SERVICE_ROLE_KEY=$VPS_SERVICE_ROLE_KEY node --experimental-strip-types worker/sync.ts auto hepsiburada'
TimeoutStartSec=20min
Nice=5
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
